@page
@model CondosmartWeb.Areas.Identity.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Alterar Senha";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body p-5">
                    <h2 class="mb-4">@ViewData["Title"]</h2>

                    <form method="post">
                        <div class="form-group mb-3">
                            <label asp-for="Input.SenhaAtual" class="form-label">Senha Atual</label>
                            <input asp-for="Input.SenhaAtual" class="form-control" />
                            <span asp-validation-for="Input.SenhaAtual" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Input.NovaSenha" class="form-label">Nova Senha</label>
                            <input asp-for="Input.NovaSenha" class="form-control" />
                            <span asp-validation-for="Input.NovaSenha" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Input.ConfirmacaoSenha" class="form-label">Confirmar Nova Senha</label>
                            <input asp-for="Input.ConfirmacaoSenha" class="form-control" />
                            <span asp-validation-for="Input.ConfirmacaoSenha" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Alterar Senha</button>
                    </form>

                    @if (!string.IsNullOrEmpty(ViewData["Message"]?.ToString()))
                    {
                        <div class="alert alert-success mt-3">@ViewData["Message"]</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
